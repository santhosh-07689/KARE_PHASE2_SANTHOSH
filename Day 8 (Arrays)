//write a java program to reverse the elements in a array  - in place reverse
5
1 2 3 4 5
5 4 3 2 1 

import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int i;
        for ( i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        int s=0,e=n-1;
        
        while(s<e){
             int temp=arr[s];
            arr[s]=arr[e];
            arr[e]=temp;
            s++;
            e--;
        }
        for(i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
}



