            Node temp = first;

            while (temp.next != first) {
                temp = temp.next;
            }

            temp.next = n;
            n.next = first;
        }
    }

    void sort() {
        if (first == null)
            return;

        Node i = first;

        do {
            Node j = i.next;

            while (j != first) {
                if (i.data > j.data) {
                    int temp = i.data;
                    i.data = j.data;
                    j.data = temp;
