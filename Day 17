// reverse elements of singly linked list
import java.util.*;

class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}

class Main {
    Node first = null;

    void insert(int d) {
        Node n = new Node(d);

        if (first == null) {
            first = n;
        } else {
            Node temp = first;

            while (temp.next != null) {
                temp = temp.next;
            }

            temp.next = n;
        }
    }

    void reverse() {
        Node prev = null;
        Node curr = first;

        while (curr != null) {
            Node next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }

        first = prev;
    }

    void display() {
        Node temp = first;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Main m = new Main();

        int d = sc.nextInt();

        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }

        m.reverse();
        m.display();
    }
}

// 10 reverse elements of doubly linked list
import java.util.*;

class Node {
    int data;
    Node next, prev;

    Node(int d) {
        data = d;
        next = null;
        prev = null;
    }
}

class Main {
    Node first = null;

    void insert(int d) {
        Node n = new Node(d);

        if (first == null) {
            first = n;
        } else {
            Node temp = first;

            while (temp.next != null) {
                temp = temp.next;
            }

            temp.next = n;
            n.prev = temp;
        }
    }

    void reverse() {
        Node curr = first;
        Node temp = null;

        while (curr != null) {
            temp = curr.prev;
            curr.prev = curr.next;
            curr.next = temp;

            curr = curr.prev;
        }

        if (temp != null) {
            first = temp.prev;
        }
    }

    void display() {
        Node temp = first;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Main m = new Main();

        int d = sc.nextInt();

        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }

        m.reverse();
        m.display();
    }
}
