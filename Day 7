// to find the odd even element count 
// i/p - 5 , 10 2 34 5 23 o/p - odd element count : 2 , even element count:3
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt(); 

        int oddCount = 0;
        int evenCount = 0;

        for (int i = 0; i < n; i++) {
            int num = sc.nextInt();

            if (num % 2 == 0) {
                evenCount++;
            } else {
                oddCount++;
            }
        }

        System.out.println("Odd element count: " + oddCount);
        System.out.println("Even element count: " + evenCount);

        sc.close();
    }
}

