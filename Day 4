import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc =  new Scanner(System.in);
		int n =sc.nextInt();
		int row,col;
		for(row=0;row<n-1;row++,System.out.println()){ //BASE 2 - TOP
		    for(col=0;col<=row;col++)
		        System.out.print("*");
		}
		for(row=0;row<n;row++,System.out.println()){ // BASE 3 -BOTTOM
		    for(col=0;col<n-row;col++)
		        System.out.print("*");
		}
	}
}

