#3 transpose matrix
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj=new Scanner(System.in);
        int r=obj.nextInt();
        int c=obj.nextInt();
        int arr[][]=new int [c][r];
        int tras[][]=new int[c][r];
        int i,j;
        System.out.print("Enter array elements:");
        for(i=0;i<r;i++)
        {
            for(j=0;j<c;j++)
            {
                arr[i][j]=obj.nextInt();
            }
        }
        for(i=0;i<c;i++)
        {
            for(j=0;j<r;j++)
            {
                tras[i][j]=arr[j][i];
            }
        }
        System.out.println("Transpose Matrix");
        for(i=0;i<c;i++,System.out.println())
        {
            for(j=0;j<r;j++)
            {
                System.out.print(tras[i][j]+" ");
            }
        }
    }
}
          
